			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777732434510</Id>
					<Name><![CDATA[computeGTraining]]></Name>
					<X>30</X><Y>1000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[emp]]></Name>
						<Type><![CDATA[Employee]]></Type>
					</Parameter>
					<Body><![CDATA[// G_Training: weighted bonus from training history
// Maps training course counts to a 0–1 contribution
// Pillar weights: General→SSG, Technical→EI+TD, Digital→TD
double general   = emp.trainingGeneral;
double technical = emp.trainingTechnical;
double digital   = emp.trainingDigital;
double total     = emp.trainingTotal;

if (total == 0) return 0.0;

// Normalise: more training = higher G_Training, capped at 1.0
return Math.min(total / 20.0, 1.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1777732552877</Id>
					<Name><![CDATA[checkSeniorAtInit]]></Name>
					<X>30</X><Y>1020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[emp]]></Name>
						<Type><![CDATA[Employee]]></Type>
					</Parameter>
					<Body><![CDATA[// Senior threshold at initialisation is LEVEL-based (hybrid rule)
// Thresholds from CLUSTERLOOKUP:
// Clusters 0 & 3 → Level 6+
// Clusters 1, 2, 5 → Level 7+
// Cluster 4 → Level 8+
int threshold;
switch (emp.clusterNum) {
    case 0: case 3: threshold = 6; break;
    case 1: case 2: case 5: threshold = 7; break;
    case 4: threshold = 8; break;
    default: threshold = 6;
}
return (emp.empLevel >= threshold) && (emp.trainingTotal > 0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777739752940</Id>
					<Name><![CDATA[updateGMentor]]></Name>
					<X>30</X><Y>1040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[clusterID]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int seniors = 0;
int juniors = 0;

for (Employee emp : employees) {
    if (emp.clusterNum == clusterID) {
        if (emp.isSenior) {
            seniors++;
        } else {
            juniors++;
        }
    }
}

double newGMentor = (juniors > 0) ? Math.min((double)seniors / juniors, 1.0) : 1.0;

if (clusterID == 0) gMentor0 = newGMentor;
else if (clusterID == 1) gMentor1 = newGMentor;
else if (clusterID == 2) gMentor2 = newGMentor;
else if (clusterID == 3) gMentor3 = newGMentor;
else if (clusterID == 4) gMentor4 = newGMentor;
else if (clusterID == 5) gMentor5 = newGMentor;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777740915695</Id>
					<Name><![CDATA[retireAgent]]></Name>
					<Description><![CDATA[Need to count how many agents retire each year so the 5% rule has a base to work from.]]></Description>
					<X>30</X><Y>1060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[emp]]></Name>
						<Type><![CDATA[Employee]]></Type>
					</Parameter>
					<Body><![CDATA[annualRetireeCount++;
employees._remove(emp);
//traceln("Agent removed: " + emp.empID + " | Remaining: " + employees.size());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777748167558</Id>
					<Name><![CDATA[computeClusterAverages]]></Name>
					<X>30</X><Y>1080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Local accumulators — reset each call
double sumBM[]  = new double[6];
double sumTD[]  = new double[6];
double sumEI[]  = new double[6];
double sumSSG[] = new double[6];
int    count[]  = new int[6];

// Loop over all living agents and accumulate by cluster
for (Employee emp : employees) {
    int c = emp.clusterNum;
    sumBM[c]  += emp.scoreBM;
    sumTD[c]  += emp.scoreTD;
    sumEI[c]  += emp.scoreEI;
    sumSSG[c] += emp.scoreSSG;
    count[c]++;
}

// Compute averages — guard against empty clusters (count = 0)
avgBM_0  = (count[0] > 0) ? sumBM[0]  / count[0] : 0;
avgBM_1  = (count[1] > 0) ? sumBM[1]  / count[1] : 0;
avgBM_2  = (count[2] > 0) ? sumBM[2]  / count[2] : 0;
avgBM_3  = (count[3] > 0) ? sumBM[3]  / count[3] : 0;
avgBM_4  = (count[4] > 0) ? sumBM[4]  / count[4] : 0;
avgBM_5  = (count[5] > 0) ? sumBM[5]  / count[5] : 0;

avgTD_0  = (count[0] > 0) ? sumTD[0]  / count[0] : 0;
avgTD_1  = (count[1] > 0) ? sumTD[1]  / count[1] : 0;
avgTD_2  = (count[2] > 0) ? sumTD[2]  / count[2] : 0;
avgTD_3  = (count[3] > 0) ? sumTD[3]  / count[3] : 0;
avgTD_4  = (count[4] > 0) ? sumTD[4]  / count[4] : 0;
avgTD_5  = (count[5] > 0) ? sumTD[5]  / count[5] : 0;

avgEI_0  = (count[0] > 0) ? sumEI[0]  / count[0] : 0;
avgEI_1  = (count[1] > 0) ? sumEI[1]  / count[1] : 0;
avgEI_2  = (count[2] > 0) ? sumEI[2]  / count[2] : 0;
avgEI_3  = (count[3] > 0) ? sumEI[3]  / count[3] : 0;
avgEI_4  = (count[4] > 0) ? sumEI[4]  / count[4] : 0;
avgEI_5  = (count[5] > 0) ? sumEI[5]  / count[5] : 0;

avgSSG_0 = (count[0] > 0) ? sumSSG[0] / count[0] : 0;
avgSSG_1 = (count[1] > 0) ? sumSSG[1] / count[1] : 0;
avgSSG_2 = (count[2] > 0) ? sumSSG[2] / count[2] : 0;
avgSSG_3 = (count[3] > 0) ? sumSSG[3] / count[3] : 0;
avgSSG_4 = (count[4] > 0) ? sumSSG[4] / count[4] : 0;
avgSSG_5 = (count[5] > 0) ? sumSSG[5] / count[5] : 0;

if (avgEI_0 < minAvgEI_0) minAvgEI_0 = avgEI_0;
if (avgEI_1 < minAvgEI_1) minAvgEI_1 = avgEI_1;
if (avgEI_3 < minAvgEI_3) minAvgEI_3 = avgEI_3;

// Cluster headcount snapshot
count_0 = count[0];
count_1 = count[1];
count_2 = count[2];
count_3 = count[3];
count_4 = count[4];
count_5 = count[5];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777748547325</Id>
					<Name><![CDATA[checkDreyfusThresholds]]></Name>
					<X>30</X><Y>1100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[final double THRESHOLD = 3.0;

// --- Update consecutive-year breach counters ---
// Cluster average checks — exclude pre-existing baseline breaches
// These now serve as DIAGNOSTIC indicators only, not crisis triggers

// Tier 1: E&I for clusters 0, 1, 3
if (!baselineBreachEI_0 && avgEI_0 < THRESHOLD) { warnCountEI_0++; } else { warnCountEI_0 = 0; }
if (!baselineBreachEI_1 && avgEI_1 < THRESHOLD) { warnCountEI_1++; } else { warnCountEI_1 = 0; }
if (!baselineBreachEI_3 && avgEI_3 < THRESHOLD) { warnCountEI_3++; } else { warnCountEI_3 = 0; }

// Tier 1: SS&G for all clusters
if (!baselineBreachSSG_0 && avgSSG_0 < THRESHOLD) { warnCountSSG_0++; } else { warnCountSSG_0 = 0; }
if (!baselineBreachSSG_1 && avgSSG_1 < THRESHOLD) { warnCountSSG_1++; } else { warnCountSSG_1 = 0; }
if (!baselineBreachSSG_2 && avgSSG_2 < THRESHOLD) { warnCountSSG_2++; } else { warnCountSSG_2 = 0; }
if (!baselineBreachSSG_3 && avgSSG_3 < THRESHOLD) { warnCountSSG_3++; } else { warnCountSSG_3 = 0; }
if (!baselineBreachSSG_4 && avgSSG_4 < THRESHOLD) { warnCountSSG_4++; } else { warnCountSSG_4 = 0; }
if (!baselineBreachSSG_5 && avgSSG_5 < THRESHOLD) { warnCountSSG_5++; } else { warnCountSSG_5 = 0; }

// --- FRI-based crisis detection ---
// WARNING: any FRI dimension drops below 70% for 2+ consecutive years
// CRISIS:  any FRI dimension drops below 50% for 2+ consecutive years
// E&I is the primary safety-critical dimension — weighted most heavily

// Count how many FRI dimensions are in sustained breach
// Using 2-year sustained rule consistent with cluster average logic
int friBreach_warning = 0;
int friBreach_crisis  = 0;

// Relative FRI threshold checks
// WARNING: FRI drops more than 10 percentage points below its baseline value
// CRISIS:  FRI drops more than 25 percentage points below its baseline value
// Only fires after baseline has been captured

if (baselineCaptured) {
	// BM
    if (friBM  < (baseFRI_BM  - friWarningThreshold)) { warnCountFRI_BM++;  } else { warnCountFRI_BM  = 0; }
    if (friBM  < (baseFRI_BM  - friCrisisThreshold))  { crisisCountFRI_BM++; } else { crisisCountFRI_BM  = 0; }

    // TD
    if (friTD  < (baseFRI_TD  - friWarningThreshold)) { warnCountFRI_TD++;  } else { warnCountFRI_TD  = 0; }
    if (friTD  < (baseFRI_TD  - friCrisisThreshold))  { crisisCountFRI_TD++; } else { crisisCountFRI_TD  = 0; }

    // EI — primary safety-critical dimension
    if (friEI  < (baseFRI_EI  - friWarningThreshold)) { warnCountFRI_EI++;  } else { warnCountFRI_EI  = 0; }
    if (friEI  < (baseFRI_EI  - friCrisisThreshold))  { crisisCountFRI_EI++; } else { crisisCountFRI_EI  = 0; }

    // SSG
    if (friSSG < (baseFRI_SSG - friWarningThreshold)) { warnCountFRI_SSG++; } else { warnCountFRI_SSG = 0; }
    if (friSSG < (baseFRI_SSG - friCrisisThreshold))  { crisisCountFRI_SSG++; } else { crisisCountFRI_SSG = 0; }
}

// Crisis detection limited to Tier 1 safety-critical dimensions only
// BM and TD tracked in FRI plot but do not trigger crisis state
if (warnCountFRI_EI  >= 2) friBreach_warning++;
if (warnCountFRI_SSG >= 2) friBreach_warning++;

if (crisisCountFRI_EI  >= 2) friBreach_crisis++;
if (crisisCountFRI_SSG >= 2) friBreach_crisis++;

// --- Headcount-based crisis detection (capacity crisis) ---
int currentHeadcount = employees.size();
int headcountBreach_warning = 0;
int headcountBreach_crisis  = 0;

if (currentHeadcount < headcountCrisisThreshold) {
    headcountBreach_crisis  = 1;
} else if (currentHeadcount < headcountWarningThreshold) {
    headcountBreach_warning = 1;
}

// --- Determine crisis state ---
int prevState = crisisState;
if (friBreach_crisis >= 1 || headcountBreach_crisis >= 1) {
    crisisState = 2;  // CRISIS
} else if (friBreach_warning >= 1 || headcountBreach_warning >= 1) {
    crisisState = 1;  // WARNING
} else {
    crisisState = 0;  // FUNCTIONAL
}

// --- Update simulation year ---
simYear = 2026 + time();

// --- Log Time-to-Crisis (fires once only) ---
if (prevState < 1 && crisisState >= 1 && yearFirstWarning < 0) {
    yearFirstWarning = simYear;
}
if (prevState < 2 && crisisState == 2 && yearCrisis < 0) {
    yearCrisis = simYear;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777796549822</Id>
					<Name><![CDATA[computeFRI]]></Name>
					<X>30</X><Y>1160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int totalAgents = employees.size();

if (totalAgents == 0) {
    friBM  = 0.0;
    friTD  = 0.0;
    friEI  = 0.0;
    friSSG = 0.0;
    return;
}

int countBM  = 0;
int countTD  = 0;
int countEI  = 0;
int countSSG = 0;

for (Employee emp : employees) {
    if (emp.scoreBM  >= 3.0) countBM++;
    if (emp.scoreTD  >= 3.0) countTD++;
    if (emp.scoreEI  >= 3.0) countEI++;
    if (emp.scoreSSG >= 3.0) countSSG++;
}

friBM  = (double)countBM  / totalAgents;
friTD  = (double)countTD  / totalAgents;
friEI  = (double)countEI  / totalAgents;
friSSG = (double)countSSG / totalAgents;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777798460825</Id>
					<Name><![CDATA[createNewHire]]></Name>
					<Description><![CDATA[Creates a single new agent, assigns it a hire profile, cluster, and baseline scores, and adds it to the population.]]></Description>
					<X>30</X><Y>1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[profile]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cluster]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Employee emp = add_employees();

emp.empID = "HIRE_" + totalHired;

// Assign hire profile and cluster
emp.hireProfile = profile;
emp.clusterNum  = cluster;
emp.yearsInRole = 0.0;
emp.isSenior    = false;

// Assign baseline scores from Bloom's matrix
if (profile.equals("RTS Graduate")) {
    emp.baselineBM  = 2.5; emp.baselineTD = 3.0;
    emp.baselineEI  = 3.5; emp.baselineSSG = 2.5;
} else if (profile.equals("Vocational Diploma & Certificate")) {
    emp.baselineBM  = 2.0; emp.baselineTD = 2.5;
    emp.baselineEI  = 2.5; emp.baselineSSG = 2.5;
} else if (profile.equals("Engineer")) {
    emp.baselineBM  = 3.5; emp.baselineTD = 4.0;
    emp.baselineEI  = 4.0; emp.baselineSSG = 3.0;
} else if (profile.equals("General Hire (Bachelors+)")) {
    emp.baselineBM  = 3.0; emp.baselineTD = 3.0;
    emp.baselineEI  = 2.0; emp.baselineSSG = 3.0;
} else {
    // Basic Education fallback
    emp.baselineBM  = 1.5; emp.baselineTD = 1.5;
    emp.baselineEI  = 1.5; emp.baselineSSG = 2.0;
}

// Initialise current scores to baseline
emp.scoreBM  = emp.baselineBM;
emp.scoreTD  = emp.baselineTD;
emp.scoreEI  = emp.baselineEI;
emp.scoreSSG = emp.baselineSSG;

// Compute gTraining for new hire
emp.gTraining = computeGTraining(emp);

// Update G_Mentor for the cluster this agent joins
updateGMentor(cluster);

totalHired++;


// --- Schedule retirement for new hire ---
double entryAge;
if (profile.equals("RTS Graduate") || profile.equals("Basic Education")) {
    entryAge = 25.0;
} else if (profile.equals("Vocational Diploma & Certificate")) {
    entryAge = 27.0;
} else {
    entryAge = 28.0;
}

double retAge = (scenarioID == 2 || scenarioID == 3) ? 65.0 : 60.0;
double yearsToRetirement = retAge - entryAge;
double retireTimeout = Math.max(yearsToRetirement + 0.75, 1.0);

emp.retirementTimeout = retireTimeout;
emp.retirementEvent.restartTo(time() + retireTimeout);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777798696776</Id>
					<Name><![CDATA[applyHiringRule]]></Name>
					<Description><![CDATA[Runs once per year, reads the retiree count, applies the 5% rule, and calls createNewHire() the appropriate number of times.]]></Description>
					<X>30</X><Y>1200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 5% rule — hire 5% of this year's retirees
annualHireCount = (int)Math.round(annualRetireeCount * 0.05);

// Per updated SRT policy direction:
// Standard hiring focuses on safety-critical operational staff
// Primary targets: Clusters 0 (Core Frontline), 1 (Specialized Technical), 3 (Essential Infrastructure)
// Residual hiring: Clusters 2, 4, 5 at reduced weight

// Empirical baseline populations:
// Cluster 0 – Core Frontline Operations Staff:        3127
// Cluster 1 – Specialized Technical Field Experts:     560
// Cluster 2 – Advanced Governance & Support:           237
// Cluster 3 – Essential Infrastructure Field Crew:    3856
// Cluster 4 – Strategic Business & Real Estate:         65
// Cluster 5 – Governance & Support Professionals:      428
// Total = 8273

// Safety-critical clusters (0, 1, 3) receive 80% of standard hires
// Non-safety clusters (2, 4, 5) receive remaining 20%
int safetyCriticalHires = (int)Math.round(annualHireCount * 0.80);
int nonSafetyHires = annualHireCount - safetyCriticalHires;

// Distribute safety-critical hires across clusters 0, 1, 3
// Weighted by their baseline populations (0=3127, 1=560, 3=3856; total=7543)
for (int i = 0; i < safetyCriticalHires; i++) {
    double r = uniform(0, 7543);
    int targetCluster;
    String targetProfile;
    if (r < 3127) {
        targetCluster = 0; targetProfile = "General Hire (Bachelors+)";
    } else if (r < 3687) {
        targetCluster = 1; targetProfile = "Engineer";
    } else {
        targetCluster = 3; targetProfile = "Engineer";
    }
    createNewHire(targetProfile, targetCluster);
}

// Distribute non-safety hires across clusters 2, 4, 5
// Weighted by their baseline populations (2=237, 4=65, 5=428; total=730)
for (int i = 0; i < nonSafetyHires; i++) {
    double r = uniform(0, 730);
    int targetCluster;
    String targetProfile;
    if (r < 237) {
        targetCluster = 2; targetProfile = "General Hire (Bachelors+)";
    } else if (r < 302) {
        targetCluster = 4; targetProfile = "General Hire (Bachelors+)";
    } else {
        targetCluster = 5; targetProfile = "General Hire (Bachelors+)";
    }
    createNewHire(targetProfile, targetCluster);
}

// Reset retiree counter for next year
annualRetireeCount = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777808172326</Id>
					<Name><![CDATA[initialiseScenario]]></Name>
					<X>30</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Initialise quota state per scenario
// Note: 2027–2031 fixed deployment is hardcoded in applyQuota()
// quotaAnnualTarget has been removed — no longer needed

if (scenarioID == 0) {
    // Scenario A — Intended Baseline: fixed 2027–2031 quota, no post-2031 quota
    quotaRemaining = 0;
}
else if (scenarioID == 1) {
    // Scenario B — Periodic Quota Continuation: fixed 2027–2031 + periodic post-2031
    quotaRemaining = 0;  // Post-2031 quota reloaded dynamically in applyQuota()
}
else if (scenarioID == 2) {
    // Scenario C — Extended Retirement Age: fixed 2027–2031 quota, no post-2031 quota
    quotaRemaining = 0;
}
else if (scenarioID == 3) {
    // Scenario D — Extended Retirement + Periodic Quota: fixed 2027–2031 + periodic post-2031
    quotaRemaining = 0;  // Post-2031 quota reloaded dynamically in applyQuota()
}
else if (scenarioID == 4) {
    // Scenario E — Accelerated Outsourcing: fixed 2027–2031 quota, no post-2031 quota
    quotaRemaining = 0;
}
else if (scenarioID == 5) {
    // Scenario F — Complete No-Quota: skip everything
    quotaRemaining = 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777808313685</Id>
					<Name><![CDATA[applyQuota]]></Name>
					<X>30</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// --- Scenario F: Complete No-Quota — skip entirely ---
if (scenarioID == 5) return;

// --- Scenario C: Extended Retirement Age — no quota by design ---
if (scenarioID == 2) return;

// --- Fixed empirical quota deployment 2027–2031 ---
// These are hardcoded annual values, not drawn from quotaAnnualTarget
// Focus: safety-critical roles (locomotive drivers, mechanics, train guards, traffic control)
// Target clusters: 0 (Core Frontline), 1 (Specialized Technical), 3 (Essential Infrastructure)
int fixedHiresThisYear = 0;
if      (simYear >= 2027 && simYear < 2028) { fixedHiresThisYear = quotaSchedule2027; }
else if (simYear >= 2028 && simYear < 2029) { fixedHiresThisYear = quotaSchedule2028; }
else if (simYear >= 2029 && simYear < 2030) { fixedHiresThisYear = quotaSchedule2029; }
else if (simYear >= 2030 && simYear < 2031) { fixedHiresThisYear = quotaSchedule2030; }
else if (simYear >= 2031 && simYear < 2032) { fixedHiresThisYear = quotaSchedule2031; }

if (fixedHiresThisYear > 0) {
    dispatchQuotaHires(fixedHiresThisYear);
    totalQuotaHired += fixedHiresThisYear;
    return;
}

// --- Post-2031 periodic quota logic ---
// Applies to Scenarios B (ID=1) and D (ID=3) only
// All other scenarios: no further quota after 2031
if (scenarioID != 1 && scenarioID != 3) return;

// NOTE: Post-2031 quota size (~2000) and frequency (every 7 years) are
// carried forward from historical pattern — treat as assumption in publication
if (simYear > 2031) {
    int yearsSince2031 = (int)(simYear - 2031);
    // NOTE: Post-2031 quota size (~2000) and frequency (every 7 years) are
    // carried forward from historical pattern — treat as assumption in publication
    int freqYears = ((Main)getEngine().getRoot()).quotaFreqYears;
    int timingOffset = ((Main)getEngine().getRoot()).quotaTimingOffset;
    int adjustedYearsSince2031 = yearsSince2031 - timingOffset;
    if (adjustedYearsSince2031 > 0 && adjustedYearsSince2031 % freqYears == 0) {
        quotaRemaining = (int)Math.round(2000 * ((Main)getEngine().getRoot()).quotaSizeScale);
    }
    if (quotaRemaining > 0) {
        int annualTarget  = 200;
        int hiresThisYear = Math.min(annualTarget, quotaRemaining);
        dispatchQuotaHires(hiresThisYear);
        totalQuotaHired  += hiresThisYear;
        quotaRemaining   -= hiresThisYear;
        if (quotaRemaining < 0) quotaRemaining = 0;
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778424910110</Id>
					<Name><![CDATA[dispatchQuotaHires]]></Name>
					<X>30</X><Y>1320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[count]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int rtsHires     = (int)Math.round(count * 0.20);
int generalHires = count - rtsHires;

// RTS graduates — alternate between clusters 1 and 3
for (int i = 0; i < rtsHires; i++) {
    int targetCluster = (i % 2 == 0) ? 1 : 3;
    createNewHire("RTS Graduate", targetCluster);
}

// General quota hires — weighted across clusters 0, 1, 3
// Baseline populations: 0=3127, 1=560, 3=3856; total=7543
for (int i = 0; i < generalHires; i++) {
    double r = uniform(0, 7543);
    int targetCluster;
    String targetProfile;
    if (r < 3127) {
        targetCluster = 0; targetProfile = "General Hire (Bachelors+)";
    } else if (r < 3687) {
        targetCluster = 1; targetProfile = "Engineer";
    } else {
        targetCluster = 3; targetProfile = "Engineer";
    }
    createNewHire(targetProfile, targetCluster);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778433114725</Id>
					<Name><![CDATA[recordBaselineBreaches]]></Name>
					<X>190</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Called once after first annualMonitor cycle
// Records which Tier 1 clusters were already below threshold at baseline
final double THRESHOLD = 3.0;

baselineBreachEI_0  = (avgEI_0  < THRESHOLD);
baselineBreachEI_1  = (avgEI_1  < THRESHOLD);
baselineBreachEI_3  = (avgEI_3  < THRESHOLD);
baselineBreachSSG_0 = (avgSSG_0 < THRESHOLD);
baselineBreachSSG_1 = (avgSSG_1 < THRESHOLD);
baselineBreachSSG_2 = (avgSSG_2 < THRESHOLD);
baselineBreachSSG_3 = (avgSSG_3 < THRESHOLD);
baselineBreachSSG_4 = (avgSSG_4 < THRESHOLD);
baselineBreachSSG_5 = (avgSSG_5 < THRESHOLD);

// Capture baseline FRI values for relative threshold comparison
baseFRI_BM  = friBM;
baseFRI_TD  = friTD;
baseFRI_EI  = friEI;
baseFRI_SSG = friSSG;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778529618456</Id>
					<Name><![CDATA[updateSeniorStatus]]></Name>
					<X>190</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Employee emp : employees) {
    if (!emp.isSenior && emp.empID.startsWith("HIRE_")) {
        if (emp.yearsInRole >= 10) {
            emp.isSenior = true;
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778583126127</Id>
					<Name><![CDATA[applyOutsourcing]]></Name>
					<X>190</X><Y>1320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Applies accelerated outsourcing attrition to non-safety clusters (2, 4, 5)
// Scenario E only — 5% of current cluster headcount removed per year.
// Outsourced staff are NOT routed through retireAgent(): they leave the
// organisation but are not retirees, so they must not inflate the retiree
// count or trigger 5% replacement hiring.
if (scenarioID != 4) return;

int[] targetClusters = {2, 4, 5};
for (int c : targetClusters) {
    java.util.List<Employee> clusterAgents = new java.util.ArrayList<>();
    for (Employee emp : employees) {
        if (emp.clusterNum == c) {
            clusterAgents.add(emp);
        }
    }

    int removeCount = (int)Math.floor(clusterAgents.size() * 0.05);
    if (removeCount == 0) continue;

    // Random selection, so outsourcing is not biased by CSV load order
    java.util.Collections.shuffle(clusterAgents, new java.util.Random(getEngine().getDefaultRandomGenerator().nextLong()));

    for (int i = 0; i < removeCount; i++) {
        Employee emp = clusterAgents.get(i);

        // Log outflow skill mass — knowledge leaves the organisation
        outflowBM  += emp.scoreBM;
        outflowTD  += emp.scoreTD;
        outflowEI  += emp.scoreEI;
        outflowSSG += emp.scoreSSG;

        // Cancel scheduled events before removal
        emp.retirementEvent.cancel();
        emp.annualSkillGrowth.cancel();
        emp.annualSeniorCheck.cancel();

        remove_employees(emp);
    }
    updateGMentor(c);
}]]></Body>
				</Function>
			</Functions>
