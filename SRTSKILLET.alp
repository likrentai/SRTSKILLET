			<Events>
				<Event>
					<Id>1777749039476</Id>
					<Name><![CDATA[annualMonitor]]></Name>
					<X>30</X><Y>1130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_YEAR]]></Unit>
						</Rate>
						<Id>1777749039474</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777795200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1.01]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1.0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Capture baseline breach state on first cycle only
if (!baselineCaptured) {
    computeClusterAverages();
    computeFRI();
    recordBaselineBreaches();
    baselineCaptured = true;
}

computeClusterAverages();
updateGMentor(0);
updateGMentor(1);
updateGMentor(2);
updateGMentor(3);
updateGMentor(4);
updateGMentor(5);
computeFRI();
checkDreyfusThresholds();
applyOutsourcing();

if (getEngine().getExperiment() instanceof MonteCarloSensitivity) {
    MonteCarloSensitivity exp = (MonteCarloSensitivity) getEngine().getExperiment();
    exp.out_bScale    = bScale;
    exp.out_offset    = scoreOffset;
    exp.out_warning   = yearFirstWarning;
    exp.out_crisis    = yearCrisis;
    exp.out_headcount = employees.size();
    exp.out_friBM     = friBM;
    exp.out_friTD     = friTD;
    exp.out_friEI     = friEI;
    exp.out_friSSG    = friSSG;    
    exp.out_minEI0            = minAvgEI_0;
    exp.out_minEI1            = minAvgEI_1;
    exp.out_minEI3            = minAvgEI_3;
    exp.out_simYear           = simYear;
    exp.out_quotaTimingOffset = quotaTimingOffset;
    exp.out_quotaSizeScale    = quotaSizeScale;
    exp.out_quotaFreqYears    = quotaFreqYears;
    
    if (mcCsvWriter != null) {
    mcCsvWriter.println(
        scenarioID        + "," +
        mcRunID           + "," +
        bScale            + "," +
        scoreOffset       + "," +
        quotaTimingOffset + "," +
        quotaSizeScale    + "," +
        quotaFreqYears    + "," +
        simYear           + "," +
        yearFirstWarning  + "," +
        yearCrisis        + "," +
        employees.size()  + "," +
        friBM             + "," +
        friTD             + "," +
        friEI             + "," +
        friSSG            + "," +
        minAvgEI_0        + "," +
        minAvgEI_1        + "," +
        minAvgEI_3
    );
    mcCsvWriter.flush();
	}
}

if ((exportCSV || stressTest) && csvWriter != null) {
    csvWriter.println(
        scenarioID        + "," +
        simYear           + "," +
        avgBM_0           + "," +
        avgBM_1           + "," +
        avgBM_2           + "," +
        avgBM_3           + "," +
        avgBM_4           + "," +
        avgBM_5           + "," +
        avgTD_0           + "," +
        avgTD_1           + "," +
        avgTD_2           + "," +
        avgTD_3           + "," +
        avgTD_4           + "," +
        avgTD_5           + "," +
        avgEI_0           + "," +
        avgEI_1           + "," +
        avgEI_2           + "," +
        avgEI_3           + "," +
        avgEI_4           + "," +
        avgEI_5           + "," +
        avgSSG_0          + "," +
        avgSSG_1          + "," +
        avgSSG_2          + "," +
        avgSSG_3          + "," +
        avgSSG_4          + "," +
        avgSSG_5          + "," +
        friBM             + "," +
        friTD             + "," +
        friEI             + "," +
        friSSG            + "," +
        count_0           + "," +
        count_1           + "," +
        count_2           + "," +
        count_3           + "," +
        count_4           + "," +
        count_5           + "," +
        gMentor0          + "," +
        gMentor1          + "," +
        gMentor3          + "," +
        annualRetireeCount + "," +
        annualHireCount   + "," +
        crisisState
    );
    csvWriter.flush();
}]]></Action>
				</Event>
				<Event>
					<Id>1777799153185</Id>
					<Name><![CDATA[annualHiring]]></Name>
					<X>30</X><Y>1230</Y>
