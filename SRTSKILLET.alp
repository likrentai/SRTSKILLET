			<Events>
				<Event>
					<Id>1777738868518</Id>
					<Name><![CDATA[retirementEvent]]></Name>
					<X>230</X><Y>-80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_YEAR]]></Unit>
						</Rate>
						<Id>1777738868516</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777795200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[retirementTimeout]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Step 1 — Log outflow skill mass to Main before removal
((Main)getOwner()).outflowBM  += scoreBM;
((Main)getOwner()).outflowTD  += scoreTD;
((Main)getOwner()).outflowEI  += scoreEI;
((Main)getOwner()).outflowSSG += scoreSSG;

// Step 2 — Trigger G_Mentor recalculation in this cluster
((Main)getOwner()).updateGMentor(clusterNum);

annualSkillGrowth.cancel();
annualSeniorCheck.cancel();
((Main)getOwner()).retireAgent(this);]]></Action>
				</Event>
				<Event>
					<Id>1777740138917</Id>
					<Name><![CDATA[annualSeniorCheck]]></Name>
					<X>230</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_YEAR]]></Unit>
						</Rate>
						<Id>1777740138915</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777795200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Mentor eligibility follows SRT practice: grade, time in grade, and formal training.
// Incumbents use observed training records; hires use the qualification timeline.
if (empID.startsWith("HIRE_")) {
    isSenior = (yearsInRole >= 13.0);
} else {
    int threshold;
    switch (clusterNum) {
        case 0: case 3: threshold = 6; break;
        case 1: case 2: case 5: threshold = 7; break;
        case 4: threshold = 8; break;
        default: threshold = 6;
    }
    isSenior = (empLevel >= threshold) && (trainingTotal > 0);
}]]></Action>
				</Event>
				<Event>
					<Id>1777745264330</Id>
					<Name><![CDATA[annualSkillGrowth]]></Name>
					<X>230</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_YEAR]]></Unit>
						</Rate>
						<Id>1777745264328</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777795200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Increment years in role
yearsInRole += 1.0;

// Get current GMentor for this agent's cluster from Main
double gMentor;
switch (clusterNum) {
    case 0: gMentor = ((Main)getOwner()).gMentor0; break;
    case 1: gMentor = ((Main)getOwner()).gMentor1; break;
    case 2: gMentor = ((Main)getOwner()).gMentor2; break;
    case 3: gMentor = ((Main)getOwner()).gMentor3; break;
    case 4: gMentor = ((Main)getOwner()).gMentor4; break;
    case 5: gMentor = ((Main)getOwner()).gMentor5; break;
    default: gMentor = 1.0;
}

// Get b exponents for this hire profile
double bBM, bTD, bEI, bSSG;
if (hireProfile.equals("Basic Education")) {
    bBM=0.45; bTD=0.40; bEI=0.55; bSSG=0.45;
} else if (hireProfile.equals("Vocational Diploma & Certificate")) {
    bBM=0.50; bTD=0.55; bEI=0.60; bSSG=0.50;
} else if (hireProfile.equals("RTS Graduate")) {
    bBM=0.55; bTD=0.60; bEI=0.70; bSSG=0.55;
} else if (hireProfile.equals("General Hire (Bachelors+)")) {
    bBM=0.65; bTD=0.60; bEI=0.45; bSSG=0.65;
} else if (hireProfile.equals("Engineer")) {
    bBM=0.70; bTD=0.65; bEI=0.65; bSSG=0.60;
} else {
    bBM=0.55; bTD=0.55; bEI=0.55; bSSG=0.55;
}

double bScale = ((Main)getOwner()).bScale;
bBM *= bScale; bTD *= bScale; bEI *= bScale; bSSG *= bScale;

// Compute G70-20-10 for each skill category
// GOJT = 0.3 (full OJT assumed for all active employees)
double gOJT = 0.3;
double g70_BM  = 0.7*gOJT + 0.2*gMentor + 0.1*gTraining;
double g70_TD  = 0.7*gOJT + 0.2*gMentor + 0.1*gTraining;
double g70_EI  = 0.7*gOJT + 0.2*gMentor + 0.1*gTraining;
double g70_SSG = 0.7*gOJT + 0.2*gMentor + 0.1*gTraining;

// Apply S(t) = SBaseline + (G70-20-10 × t^b)
// Cap at 5.0
double offset = ((Main)getOwner()).scoreOffset;
scoreBM  = Math.min(Math.max(baselineBM  + offset + g70_BM  * Math.pow(yearsInRole, bBM),  1.0), 5.0);
scoreTD  = Math.min(Math.max(baselineTD  + offset + g70_TD  * Math.pow(yearsInRole, bTD),  1.0), 5.0);
scoreEI  = Math.min(Math.max(baselineEI  + offset + g70_EI  * Math.pow(yearsInRole, bEI),  1.0), 5.0);
scoreSSG = Math.min(Math.max(baselineSSG + offset + g70_SSG * Math.pow(yearsInRole, bSSG), 1.0), 5.0);]]></Action>
				</Event>
			</Events>
