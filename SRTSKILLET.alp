		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1777730958375</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[try {
    java.io.BufferedReader br = new java.io.BufferedReader(
        new java.io.FileReader("SRT2026HPBLOOM.csv")
    );
   
    String line;
    // Skip header row
    br.readLine();
  
    while ((line = br.readLine()) != null) {
        String[] row = line.split(",(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)", -1);
        Employee emp = add_employees();
      
        // --- Identity & Demographics ---
        emp.empID        = row[0].trim();
        emp.empLevel     = Integer.parseInt(row[1].trim());
        emp.empType      = row[2].trim();
        emp.department   = row[3].trim();
        emp.ageBaseline  = Double.parseDouble(row[5].trim());
        emp.turn60       = row[6].trim();
      
        // --- Retirement Scheduling ---
        emp.retirementYear    = Integer.parseInt(row[7].trim());
        emp.retirementDate    = row[8].trim();
        emp.retireGroup       = row[9].trim();
        emp.yearsToRetirement = Double.parseDouble(row[10].trim());
      
        // --- Training History ---
        emp.trainingGeneral   = Integer.parseInt(row[11].trim());
        emp.trainingTechnical = Integer.parseInt(row[12].trim());
        emp.trainingDigital   = Integer.parseInt(row[13].trim());
        emp.trainingTotal     = Integer.parseInt(row[14].trim());
      
        // --- Cluster Assignment ---
        emp.clusterNum   = Integer.parseInt(row[15].trim());
        emp.clusterLabel = row[16].trim();
      
        // --- Hire Profile ---
        emp.hireProfile = row[17].trim();
      
        // --- Bloom's Baseline Scores ---
        if (row[18].trim().isEmpty() || row[18].trim().equals("NaN")) {
            emp.baselineBM  = 2.5;
            emp.baselineTD  = 2.5;
            emp.baselineEI  = 2.5;
            emp.baselineSSG = 2.5;
            emp.hireProfile = "General Hire (Bachelors+)";
        } else {
            emp.baselineBM  = Double.parseDouble(row[18].trim());
            emp.baselineTD  = Double.parseDouble(row[19].trim());
            emp.baselineEI  = Double.parseDouble(row[20].trim());
            emp.baselineSSG = Double.parseDouble(row[21].trim());
        }
      
        // --- Initialise live variables to baseline ---
        emp.scoreBM  = emp.baselineBM;
        emp.scoreTD  = emp.baselineTD;
        emp.scoreEI  = emp.baselineEI;
        emp.scoreSSG = emp.baselineSSG;
      
        // --- Initialise derived variables ---
        emp.yearsInRole = Math.max(0.0, emp.ageBaseline - 22.0);
        emp.gTraining   = computeGTraining(emp);
        emp.isSenior    = checkSeniorAtInit(emp);
       
        // --- Schedule retirement event ---
        // Agents already retired under the age-60 rule are not carried into the simulation. The age-65 policy (Scenarios C and D) commences in 2027 and defers only those still active at the baseline.
		if (emp.retirementYear <= 2026) {
    		remove_employees(emp);
    		continue;
		}
		double retireTimeout = (emp.retirementYear - 2026) + 0.75;
		if (scenarioID == 2 || scenarioID == 3) {
		    retireTimeout += 5.0;
		}
		emp.retirementEvent.restartTo(retireTimeout);
    }
  
    br.close();
    traceln("Agents loaded: " + employees.size());
  
} catch (Exception e) {
    traceln("CSV load error: " + e.getMessage());
}

// Compute mentorship ratios from the loaded population before the first
// annual skill growth event reads them.
for (int c = 0; c < 6; c++) {
    updateGMentor(c);
}

if (exportCSV || stressTest) {
    try {
        String filename = stressTest
            ? "STRESSTEST" + stressTestID + ".csv"
            : "SCENARIO" + scenarioID + ".csv";
        java.io.FileWriter fw = new java.io.FileWriter(filename, false);
        csvWriter = new java.io.PrintWriter(fw);
        csvWriter.println(
            "scenarioID,year," +
            "avgBM_0,avgBM_1,avgBM_2,avgBM_3,avgBM_4,avgBM_5," +
            "avgTD_0,avgTD_1,avgTD_2,avgTD_3,avgTD_4,avgTD_5," +
            "avgEI_0,avgEI_1,avgEI_2,avgEI_3,avgEI_4,avgEI_5," +
            "avgSSG_0,avgSSG_1,avgSSG_2,avgSSG_3,avgSSG_4,avgSSG_5," +
            "friBM,friTD,friEI,friSSG," +
            "count_0,count_1,count_2,count_3,count_4,count_5," +
            "gMentor0,gMentor1,gMentor3," +
            "annualRetireeCount,annualHireCount," +
            "crisisState"
        );
    } catch (Exception e) {
        traceln("CSV file error: " + e.getMessage());
    }
}

if (getEngine().getExperiment() instanceof MonteCarloSensitivity) {
    bScale            = uniform(0.5,  1.5);
    scoreOffset       = uniform(-0.5, 0.5);
    quotaTimingOffset = (int)Math.round(uniform(-2, 2));
    quotaSizeScale    = uniform(0.7,  1.3);
    quotaFreqYears    = (int)Math.round(uniform(5, 10));
    
    MonteCarloSensitivity exp = (MonteCarloSensitivity)getEngine().getExperiment();
    if (exp.runCounter == 0) {
        try {
            String filename = "MC_SCENARIO" + scenarioID + ".csv";
            java.io.FileWriter fw = new java.io.FileWriter(filename, false);
            mcCsvWriter = new java.io.PrintWriter(fw);
            mcCsvWriter.println(
                "scenarioID,run,bScale,scoreOffset,quotaTimingOffset," +
                "quotaSizeScale,quotaFreqYears,simYear," +
                "warning,crisis,headcount," +
                "friBM,friTD,friEI,friSSG," +
                "minEI0,minEI1,minEI3"
            );
        } catch (Exception e) {
            traceln("MC CSV error: " + e.getMessage());
        }
    } else {
        // Reuse the existing writer from the experiment object
        mcCsvWriter = exp.mcCsvWriter;
    }
    mcRunID = exp.runCounter;
}
if (getEngine().getExperiment() instanceof MonteCarloSensitivity) {
    ((MonteCarloSensitivity)getEngine().getExperiment()).mcCsvWriter = mcCsvWriter;
}]]></StartupCode>
			<DestroyCode><![CDATA[if (csvWriter != null) {
    csvWriter.flush();
    csvWriter.close();
}]]></DestroyCode>
